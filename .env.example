# From @BotFather. Leave empty to preview in a browser with no Telegram account.
BOT_TOKEN=
# Filled from Telegram automatically when BOT_TOKEN is set. Override if you want.
BOT_USERNAME=
# Public https origin Telegram will open. Example: https://chicken.example.com
PUBLIC_URL=http://127.0.0.1:8787
# Optional Telegram channel username, without @. Unlocks the channel task.
CHANNEL_USERNAME=
PORT=8787
# 1 forces the browser preview on. 0 forces it off.
# When unset: preview is on only if BOT_TOKEN is empty.
DEV_MODE=
