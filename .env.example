# From @BotFather. Required: the app only accepts players signed in through Telegram.
BOT_TOKEN=
# Filled from Telegram automatically when BOT_TOKEN is set. Override if you want.
BOT_USERNAME=
# Public https origin Telegram will open. Example: https://chicken.example.com
# On Railway you can leave this empty; it uses the service's Railway domain.
PUBLIC_URL=
PORT=8787
# 0.0.0.0 on a host like Railway. The Dockerfile sets this for you.
HOST=127.0.0.1
# Where chicken.sqlite lives. On Railway this is the volume, /data.
DATA_DIR=
